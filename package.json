{
  "name": "pi-message-time",
  "version": "0.1.0",
  "description": "Fixed, timezone-aware inline message timestamps for the Pi agent",
  "type": "module",
  "license": "MIT",
  "keywords": ["pi-package", "datetime", "timestamps"],
  "files": ["src", "README.md", "LICENSE"],
  "exports": {".": "./src/index.js"},
  "pi": {"extensions": ["./src/index.js"]},
  "engines": {"node": ">=22.18"},
  "scripts": {"check": "node --check src/index.js && node --check src/timestamps.js && node --test test/*.test.js", "test": "node --test test/*.test.js"},
  "peerDependencies": {"@earendil-works/pi-coding-agent": ">=1.5.2"},
  "devDependencies": {"@earendil-works/pi-coding-agent": "1.5.2", "@earendil-works/pi-ai": "1.5.2", "typebox": "1.3.27"},
  "repository": {"type": "git", "url": "https://github.com/aristath/pi-message-time.git"},
  "homepage": "https://github.com/aristath/pi-message-time#readme",
  "bugs": {"url": "https://github.com/aristath/pi-message-time/issues"}
}
